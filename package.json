{
  "name": "squishy-cannon-chaos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:levels": "tsx tests/levels.ts",
    "e2e": "tsx scripts/e2e.ts",
    "shots": "tsx scripts/shots.ts",
    "checklist": "node -e \"process.stdout.write(require('fs').readFileSync('CHECKLIST.md','utf8'))\""
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "pixi.js": "^8.22.0",
    "planck": "^1.5.0",
    "pretendard": "^1.3.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
